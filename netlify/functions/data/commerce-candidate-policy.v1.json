{
  "version": "commerce-candidate-policy-v1.3.0-balanced-consumer-research",
  "contractVersion": "sanmaru-searchbank-commerce-candidate-intake-v1.2",
  "mode": "stage-before-publication-key",
  "purpose": "Select country-eligible, rights-safe and market-verifiable goods before Canonical Snapshot publication. Public release requires a verified payable non-PG revenue right (approved affiliate, advertising, sponsorship, brokerage, referral or lead agreement). Traffic-only external referrals remain private review candidates and are never represented as confirmed product revenue.",
  "publication": {
    "defaultMode": "staging_only",
    "enableEnv": "COMMERCE_CANDIDATE_RELEASE_MODE",
    "enableValue": "enabled",
    "keyEnv": "COMMERCE_CANDIDATE_RELEASE_KEY",
    "minimumKeyLength": 32,
    "requireManualReleaseKey": true,
    "allowAutomaticPublicPromotion": false
  },
  "sources": {
    "external_brokerage": {
      "requiresVerifiedRevenueRight": true,
      "requiresExplicitAffiliateOrBrokerageContract": true,
      "rankBoost": 1800,
      "requiresApprovedManualAffiliateOrOfficialOutboundReferral": true
    },
    "approved_commerce_member": {
      "requiresAdminApproval": true,
      "requiresApprovedListingAssignment": true,
      "requiresDirectSellerResponsibility": true,
      "rankBoost": 5000
    },
    "managed_sponsor": {
      "requiresAdminApproval": true,
      "requiresDisclosure": true,
      "rankBoost": 3500
    }
  },
  "eligibility": {
    "requireProductIdentity": true,
    "requireExternalHttpsDestination": true,
    "requireImageHttps": true,
    "requireExactPsomPlacement": true,
    "requireMarketSaleEvidence": true,
    "requireFreshMarketEvidence": true,
    "marketEvidenceMaxAgeDays": 30,
    "requireSearchBankEligibilityFlags": true,
    "requireTrustedSellerOrProducer": true,
    "requireNonPgRevenueRight": true,
    "rejectSamplesAndPlaceholders": true,
    "rejectUnknownSourceTier": true,
    "requirePayableRevenueQualification": true
  },
