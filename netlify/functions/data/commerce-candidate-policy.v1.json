  "revenue": {
    "allowedTypes": [
      "advertising",
      "affiliate",
      "brokerage",
      "external_referral",
      "lead",
      "manual_affiliate",
      "referral",
      "sponsor"
    ],
    "requireVerifiedAffiliateTracking": true,
    "requireApprovedDirectAgreement": true,
    "allowUnknownRevenueOnlyInReviewQueue": true,
    "maxCommissionRate": 1,
    "maxExpectedConversionRate": 1,
    "sourcePriority": {
      "approved_commerce_member": 100,
      "managed_sponsor": 80,
      "external_brokerage": 60
    },
    "allowVerifiedExternalReferral": true,
    "externalReferralCreatesConfirmedProductRevenue": false,
    "externalReferralTrafficValueOnly": true,
    "manualAffiliateRequiresProgramRegistry": true,
    "manualAffiliateRequiresPolicyReview": true,
    "apiProviderIntegrationDefault": "disabled",
    "requirePayableRevenueRightForPublicRelease": true,
    "allowTrafficOnlyPublicRelease": false,
    "allowTrafficOnlyInReviewQueue": true,
    "trafficOnlyRequiresManualUpgradeBeforeRelease": true,
    "directAgreementEvidence": {
      "requireApprovedState": true,
      "requireContractOrProgramId": true,
      "requireCounterparty": true,
      "requireDisclosureApproval": true,
      "requirePayoutBasisOrSettlementMode": true,
      "acceptedSettlementModes": [
        "manual_invoice",
        "bank_transfer",
        "provider_statement",
        "settlement_statement",
        "fixed_fee",
        "per_lead",
        "cpc",
        "cpa",
        "cps",
        "commission",
        "operator_approved_statement_or_invoice"
      ]
    },
    "trafficOnlyMonetizationState": "traffic_value_only_review"
  },
  "ranking": {
    "weights": {
      "sourcePriority": 50,
      "essentiality": 24,
      "affordability": 10,
      "repeatPurchase": 8,
      "sellerTrust": 18,
      "marketReadiness": 22,
      "revenueCertainty": 24,
      "expectedNetRevenue": 12,
      "searchExposure": 6,
      "conversionQuality": 8,
      "operatorCostPenalty": 14,
      "riskPenalty": 30,
      "trafficValue": 4
    },
    "searchExposure": {
      "minimumVerifiedImpressions": 100,
      "minimumVerifiedOutboundClicks": 10,
      "maximumContribution": 6,
      "ignoreUnverifiedClientSignals": true
    },
    "priorityOrder": [
      "approved_commerce_member",
      "managed_sponsor",
      "external_brokerage"
    ],
    "trafficValue": {
      "maximumContribution": 4,
      "requiresServerVerifiedOutboundSignals": true,
      "doesNotRepresentAffiliateRevenue": true
    }
  },
  "reviewQueue": {
    "maxQueueAgeDays": 7,
    "directMemberRequiresApprovalState": "approved",
    "directMemberRequiresAssignmentState": [
      "approved",
      "pinned"
    ],
    "allowReleaseOnlyWhenAllExistingCanonicalChecksPass": true,
    "queueIsNotPublicSupply": true,
    "requireApprovedOutboundReferralForExternalRelease": true,
    "manualAffiliateApiDisabledAllowed": true,
    "outboundRevenueStateMustBeDisclosed": true,
    "requirePayableRevenueQualificationForRelease": true,
    "trafficOnlyCandidateState": "revenue_review_required",
    "trafficOnlyCandidateIsPublicSupply": false
  }
