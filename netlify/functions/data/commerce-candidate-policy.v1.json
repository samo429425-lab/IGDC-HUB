{
  "version": "commerce-candidate-policy-v1.1.0-manual-affiliate-external-referral",
  "contractVersion": "sanmaru-searchbank-commerce-candidate-intake-v1.1",
  "mode": "stage-before-publication-key",
  "purpose": "Select everyday, rights-safe and market-verifiable goods before Canonical Snapshot publication. Support approved manual affiliate links and verified official external referrals without direct payment, provider API calls, or undisclosed revenue claims.",
  "publication": {
    "defaultMode": "staging_only",
    "enableEnv": "COMMERCE_CANDIDATE_RELEASE_MODE",
    "enableValue": "enabled",
    "keyEnv": "COMMERCE_CANDIDATE_RELEASE_KEY",
    "minimumKeyLength": 32,
    "requireManualReleaseKey": true,
    "allowAutomaticPublicPromotion": false
  },
  "sources": {
    "external_brokerage": {
      "requiresVerifiedRevenueRight": false,
      "requiresExplicitAffiliateOrBrokerageContract": false,
      "rankBoost": 1800,
      "requiresApprovedManualAffiliateOrOfficialOutboundReferral": true
    },
    "approved_commerce_member": {
      "requiresAdminApproval": true,
      "requiresApprovedListingAssignment": true,
      "requiresDirectSellerResponsibility": true,
      "rankBoost": 5000
    },
    "managed_sponsor": {
      "requiresAdminApproval": true,
      "requiresDisclosure": true,
      "rankBoost": 3500
    }
  },
  "eligibility": {
    "requireProductIdentity": true,
    "requireExternalHttpsDestination": true,
    "requireImageHttps": true,
    "requireExactPsomPlacement": true,
    "requireMarketSaleEvidence": true,
    "requireFreshMarketEvidence": true,
    "marketEvidenceMaxAgeDays": 30,
    "requireSearchBankEligibilityFlags": true,
    "requireTrustedSellerOrProducer": true,
    "requireNonPgRevenueRight": true,
    "rejectSamplesAndPlaceholders": true,
    "rejectUnknownSourceTier": true
  },
  "essentialGoods": {
    "preferredClasses": [
      "food_grocery",
      "household_essentials",
      "personal_care",
      "beauty_everyday",
      "basic_apparel",
      "small_electronics",
      "home_appliance_small",
      "family_education",
      "producer_cooperative",
      "local_essential_service",
      "travel_product"
    ],
